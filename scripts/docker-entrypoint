#!/usr/bin/env sh
set -e

SSH_KEY="/avakas-key"
AVAKAS="/opt/avakas/bin/avakas"

problems() {
    echo "Error: ${1}"
    exit 1
}

ACTION="$1"
if [ -z "$ACTION" ] ; then
    echo "avakas docker container ${VERSION}"
    "$AVAKAS" help
    exit 1
fi

shift
if [ "$ACTION" = "bump" ] || [ "$ACTION" = "set" ] ; then
    SSH_DIR="${HOME}/.ssh"
    mkdir -p "${SSH_DIR}" 2>/dev/null || {
        SSH_DIR="/tmp/.ssh"
        mkdir -p "${SSH_DIR}"
        export HOME="/tmp"
    }

    if [ -z "$SSH_AUTH_SOCK" ] ; then
        if [ ! -e "$SSH_KEY" ] ; then
            problems "SSH private key not found"
        elif ! grep -q "PRIVATE KEY" "$SSH_KEY" ; then
            problems "SSH private key is corrupt"
        fi
    fi

    if [ -n "$SSH_SCAN_HOST" ] ; then
        ssh-keyscan "$SSH_SCAN_HOST" 2>/dev/null 1>"${SSH_DIR}/known_hosts" || problems "Unable to load git host key"
    fi
    chmod -R og-rwx "${SSH_DIR}" 2>/dev/null || true

    # OpenSSH may resolve its home from /etc/passwd instead of $HOME.
    export GIT_SSH_COMMAND="ssh -o UserKnownHostsFile=${SSH_DIR}/known_hosts"
fi

if [ -e "/etc/avakas/avakasrc" ] ; then
    # shellcheck disable=SC1091
    . /etc/avakas/avakasrc
fi
exec "$AVAKAS" "$ACTION" "$@"
