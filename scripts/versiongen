#!/usr/bin/env bash
set -e
# always know where your towel is
SCRIPT_DIR=$(cd "${0%/*}" && pwd)
export ROOTDIR="${SCRIPT_DIR%/*}"

dbg() {
    >&2 echo "$*"
}

problems() {
    >&2 echo "Error: $*"
    exit 1
}

declare AVAKAS

if [ -z "$CI" ] ; then
    AVAKAS="${ROOTDIR}/.ci-env/bin/avakas"
    if [ ! -e "$AVAKAS" ] ; then
	problems "Cannot eat own dogfood; avakas not found in repo venv"
    fi
else
    set -x
    AVAKAS="avakas"
    if ! command -v "avakas" &> /dev/null ; then
	problems "Cannot eat own dogfood; avakas not found in PATH"
    fi
fi

avakas --help

VSN="$("$AVAKAS" show "$ROOTDIR" --flavor git-native 2> /dev/null)"

if [ -z "$VSN" ] ; then
    problems "unable to determine version"
fi

sed -e "s/@@VERSION@@/${VSN}/" < "${ROOTDIR}/templates/setup.py" > "${ROOTDIR}/setup.py"

dbg "Generated files at version ${VSN}"
